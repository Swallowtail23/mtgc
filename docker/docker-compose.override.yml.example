version: '3.8'
services:
  web:
    # Example of custom ini file and card image path
    volumes:
      - /opt/mtg/mtg_new.ini:/opt/mtg/mtg_new.ini:ro
      - /srv/cardimg:/mnt/data/cardimg
    ports:
      - "8082:80"
  db:
    # Credentials are generated by docker-init and loaded from
    # ${BASE_DIR}/secrets/mysql.env. Do not add passwords to this override.
