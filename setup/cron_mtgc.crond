# Cron.d-ready version (includes user column: root)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SCRIPT_ROOT=/opt/mtg/scripts
LOG_ROOT=/var/log/mtg

5 0 * * * root /usr/sbin/logrotate /etc/logrotate.d/mtgc
0 1 * * 0 root "$SCRIPT_ROOT"/data_updates.sh weekly >> "$LOG_ROOT"/cron_data_weekly.log 2>&1
0 4 * * 1-6 root "$SCRIPT_ROOT"/data_updates.sh nightly >> "$LOG_ROOT"/cron_data_nightly.log 2>&1
