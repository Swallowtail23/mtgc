<?xml version="1.0"?>
<ruleset name="MTG Collection PHPCS">
    <description>
        PSR-12 baseline for a non-namespaced legacy app,
        with PHP 8.3 compatibility checks and global exclusions.
    </description>

    <!-- Scan the whole project -->
    <file>.</file>

    <!-- File extensions -->
    <arg name="extensions" value="php,inc,phtml"/>

    <!-- Global excludes -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>includes/analyticstracking.php</exclude-pattern>

    <!-- CLI / maintenance paths -->
    <exclude-pattern>*/bulk/*</exclude-pattern>
    <exclude-pattern>*/setup/*</exclude-pattern>
    <exclude-pattern>*/cli/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>
    <exclude-pattern>*/scripts/*</exclude-pattern>
    <exclude-pattern>*/console/*</exclude-pattern>

    <!-- Base coding standard -->
    <rule ref="PSR12">
        <exclude name="Generic.ControlStructures.AlternativeControlStructure.NotAllowed"/>
        <exclude name="Generic.ControlStructures.InlineControlStructure.NotAllowed"/>
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <!-- Relax test fixtures -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- PHP compatibility -->
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.2-8.4"/>
</ruleset>
