<?xml version="1.0"?>
<ruleset name="MTG Collection PHPCS">
    <description>
        PSR-12 baseline for a non-namespaced, global-class legacy app, with
        template-style control structure allowance and ignores for vendor,
        storage, and CLI-oriented paths.
    </description>

    <!-- Scan the whole project by default -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- Global ignores -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>vendor/**</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>storage/**</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/storage/**</exclude-pattern>

    <!-- CLI scripts (bulk jobs, setup scripts, and any bin/cli/shell folders) -->
    <exclude-pattern>bulk/*</exclude-pattern>
    <exclude-pattern>setup/*</exclude-pattern>
    <exclude-pattern>*/cli/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>
    <exclude-pattern>*/scripts/*</exclude-pattern>
    <exclude-pattern>*/console/*</exclude-pattern>

    <!-- Base standard -->
    <rule ref="PSR12">
        <!-- Allow template-style alternative control structures (if/else/endif blocks) -->
        <exclude name="Generic.ControlStructures.AlternativeControlStructure.NotAllowed"/>
        <exclude name="Generic.ControlStructures.InlineControlStructure.NotAllowed"/>

        <!-- App is intentionally not namespaced; allow global classes and side-effect files -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
</ruleset>
